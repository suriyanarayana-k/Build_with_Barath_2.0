# ===== APPLICATION CONFIGURATION =====
APP_ENV=dev
DEMO_MODE=true
JWT_SECRET=dev-insecure-secret-change-in-production
JWT_EXPIRY_SECONDS=3600
# Dashboard cookies automatically use Secure when APP_ENV=prod. Local HTTP needs false.
# CONSOLE_COOKIE_SECURE=true
CONSOLE_PASSWORD_MIN_LENGTH=12
CONSOLE_AUTH_RATE_LIMIT=10/minute

# ===== CREDENTIALS =====
DEMO_PASSWORD=changeme123
ADMIN_PASSWORD=admin_changeme123
TENANT_SIGNUP_KEY=dev-insecure-signup-key-change-in-production

# ===== DATABASE (PostgreSQL) =====
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/cyberaccess
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=5
POSTGRES_DB=cyberaccess
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# ===== REDIS CACHING =====
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL_AUTH_CONTEXT=600
REDIS_CACHE_TTL_QUOTAS=60

# ===== RATE LIMITING & QUOTAS =====
DEFAULT_REQUESTS_PER_MINUTE=1000
DEFAULT_MAX_AUDIT_EVENTS=1000000
DEFAULT_AUDIT_RETENTION_DAYS=365
DEFAULT_RISK_THRESHOLD_BLOCK=90
DEFAULT_RISK_THRESHOLD_WARN=70
RATE_LIMIT_WINDOW_SECONDS=60
QUOTA_ALERT_THRESHOLD_PERCENT=80
QUOTA_ALERT_BATCH_SIZE=50

# ===== ALERTING SYSTEM =====
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@cyberaccess.io
SMTP_PASSWORD=your-app-password-here

# Alert Timeouts
ALERT_SLACK_TIMEOUT=5
ALERT_EMAIL_TIMEOUT=10
ALERT_WEBHOOK_TIMEOUT=5

# ===== CORS & SECURITY =====
FRONTEND_ORIGIN=*
BCRYPT_ROUNDS=4

# ===== GRAFANA =====
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# ===== SERVICE PORTS =====
POSTGRES_PORT=5432
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
BACKEND_PORT=8000
FRONTEND_PORT=5173
DJANGO_PORT=8001

# ===== PHASE 4: ADVANCED THREAT DETECTION =====
THREAT_DETECTION_ENABLED=true
IP_REPUTATION_LOOKBACK_SECONDS=3600
IP_REPUTATION_VIOLATION_THRESHOLD=5
# Optional: only called if set, using your own AbuseIPDB account (https://www.abuseipdb.com/)
ABUSEIPDB_API_KEY=
ABUSEIPDB_SCORE_THRESHOLD=50
# Off by default - makes a real external network call per request when enabled
GEO_LOOKUP_ENABLED=false
GEO_VELOCITY_MAX_KMH=900
BEHAVIORAL_BASELINE_MIN_SAMPLES=20
BEHAVIORAL_DEVIATION_MULTIPLIER=3.0
# Comma-separated JA3 hashes forwarded by your TLS-terminating proxy/CDN via X-JA3-Fingerprint.
# Empty by default - seed this with your own threat-intel feed, not fabricated example values.
TLS_FINGERPRINT_BLOCKLIST=

# ===== PHASE 5: ROI CALCULATOR =====
# Illustrative defaults, not verified industry benchmarks - override with figures specific
# to your organization (see GET /tenants/{id}/analytics/roi's methodology_note).
ROI_ASSUMED_COST_PER_BREACH_USD=50000
ROI_ASSUMED_BREACH_PROBABILITY_PER_ATTACK=0.02
ROI_ASSUMED_MANUAL_REVIEW_MINUTES_PER_EVENT=15
ROI_ASSUMED_ENGINEER_HOURLY_COST_USD=75

# ===== PHASE 6: THIRD-PARTY SIEM INTEGRATIONS =====
# Both off by default - SOC alerts (BOLA blocks) are forwarded only when enabled.
# For general metrics (not just alerts), point a Datadog Agent's OpenMetrics check
# or a Splunk Prometheus-scrape input at GET /metrics instead - it already exists.
DATADOG_ENABLED=false
DATADOG_API_KEY=
DATADOG_SITE=datadoghq.com
SPLUNK_HEC_ENABLED=false
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=
SPLUNK_HEC_SOURCETYPE=cyberaccess:soc_alert
