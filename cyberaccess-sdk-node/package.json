{
  "name": "@cyberaccess/sdk",
  "version": "0.1.0",
  "description": "Drop-in BOLA/IDOR behavioral defense for Node.js APIs - a thin client for CyberAccess's /v1/authorize product API.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js",
      "require": "./dist/express.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "bola",
    "idor",
    "authorization",
    "security",
    "api-security"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.3",
    "express": "^4.19.2",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "vitest": "^5.0.3",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "express": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  }
}
